{
  "name": "p2p-server",
  "version": "0.1.0",
  "private": true,
  "description": "Aplicativo desktop local-first de comunicação P2P.",
  "main": "./out/main/index.js",
  "scripts": {
    "electron:install": "install-electron",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "dist": "npm run build && electron-builder --win",
    "dist:portable": "npm run build && electron-builder --win portable",
    "dist:installer": "npm run build && electron-builder --win nsis",
    "site:sync": "node scripts/sync-website-release.js",
    "site:deploy": "npm run site:sync && npx vercel --prod website",
    "site:preview": "npx serve website",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --fileParallelism=false",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.13.0"
}
